<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_card_bg"
    android:padding="12dp">

    <!-- Normal Content Layout (when favorites exist) -->
    <LinearLayout
        android:id="@+id/widget_fav_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="visible">

        <!-- Left: Wallpaper Preview Thumbnail -->
        <FrameLayout
            android:id="@+id/widget_fav_image_container"
            android:layout_width="105dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_m3_preview_bg">

            <ImageView
                android:id="@+id/widget_fav_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Favorite Wallpaper Preview"
                android:scaleType="centerCrop" />

            <!-- Favorite Star Chip -->
            <LinearLayout
                android:id="@+id/widget_fav_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/widget_m3_chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="7dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="Star"
                    android:src="@drawable/ic_widget_star" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="FAV"
                    android:textColor="#FFD700"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right: Info and Material You Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Counter -->
            <TextView
                android:id="@+id/widget_fav_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Favorite Wallpaper"
                android:textColor="#E6E1E5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_fav_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Favorite 1 of 1"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_fav_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Quick Set Wallpaper"
                android:textColor="#CAC4D0"
                android:textSize="10sp" />

            <!-- Spacer -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Material You Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Next Favorite Button -->
                <LinearLayout
                    android:id="@+id/widget_btn_fav_next"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_m3_btn_secondary"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Next Favorite"
                        android:src="@drawable/ic_widget_next" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Next"
                        android:textColor="#E6E1E5"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quick Apply / Enable Wallpaper Button -->
                <LinearLayout
                    android:id="@+id/widget_btn_fav_apply"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/widget_m3_btn_primary"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Set Wallpaper"
                        android:src="@drawable/ic_widget_wallpaper_set" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Apply"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State Layout (when user has 0 favorites) -->
    <LinearLayout
        android:id="@+id/widget_fav_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Empty Star"
            android:src="@drawable/ic_widget_star" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No Favorites Yet"
            android:textColor="#E6E1E5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Heart wallpapers in WallSafe to display them here"
            android:textColor="#938F99"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/widget_btn_fav_explore"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_m3_btn_primary"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open WallSafe"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
