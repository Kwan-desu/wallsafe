<Window x:Class="WallSafe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallSafe Settings"
        FontFamily="Segoe UI"
        Width="460" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgBrush}"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 Header Title (Draggable)
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettingsGeo}" Fill="{DynamicResource AccentHoverBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="WallSafe Settings" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI Bold" FontSize="16"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                        Click="Close_Click" Padding="8,4">
                    <Path Data="{StaticResource IconCloseGeo}" Fill="{DynamicResource SubtextBrush}"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 Main Settings Content
                 ═══════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">

                    <!-- Theme Mode Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconSunGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="APPEARANCE &amp; THEME" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Choose between clean Windows 11 Dark Mode or Light Mode."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeDarkRadio" Content="Dark Mode"
                                             GroupName="ThemeModeGroup" Style="{StaticResource FilterPillStyle}"
                                             IsChecked="True" Checked="Theme_Checked" Margin="0,0,10,0"/>
                                <RadioButton x:Name="ThemeLightRadio" Content="Light Mode"
                                             GroupName="ThemeModeGroup" Style="{StaticResource FilterPillStyle}"
                                             Checked="Theme_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Windows Startup & Background Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconPowerGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="WINDOWS STARTUP &amp; BACKGROUND" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Configure WallSafe to launch when Windows starts and run in background mode."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkAutoStart" Content="Launch WallSafe on Windows startup"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                                      Checked="ChkAutoStart_CheckedChanged" Unchecked="ChkAutoStart_CheckedChanged"/>

                            <StackPanel Margin="22,0,0,0">
                                <CheckBox x:Name="ChkStartMinimized" Content="Start hidden in background (System Tray only)"
                                          Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="When starting up, WallSafe remains minimized to the system tray with a reduced memory footprint."
                                           Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap"
                                           FontFamily="Segoe UI" FontSize="9.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Safe Wallpaper Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconShieldGeo}" Fill="{DynamicResource EmeraldBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="SAFE (PANIC) WALLPAPER" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="The wallpaper instantly restored when triggering the panic shortcut."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <!-- Safe Wallpaper Preview Thumbnail -->
                            <Border Height="70" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True"
                                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Image x:Name="SafeImagePreview" Stretch="UniformToFill"/>
                            </Border>

                            <TextBox x:Name="SafePathBox" Style="{StaticResource ModernSearchBox}"
                                     IsReadOnly="True" Margin="0,0,0,8" TextChanged="SafePathBox_TextChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource TabButton}"
                                        Content="Browse Image…" Margin="0,0,4,0"
                                        Click="BrowseSafe_Click"/>
                                <Button Grid.Column="1" Style="{StaticResource TabButton}"
                                        Content="Win 11 Default" Margin="4,0,0,0"
                                        Click="ResetWin11Safe_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Global Panic Hotkey Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconBoltGeo}" Fill="{DynamicResource AmberBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="GLOBAL PANIC HOTKEY" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Click the shortcut box below and press up to 3 keys (e.g. Ctrl + Shift + W, Alt + Q, F12) to record."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <!-- Interactive 3-Key Recorder Box -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HotkeyRecordBox"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Cursor="Hand"
                                        Focusable="True"
                                        FocusVisualStyle="{x:Null}"
                                        MouseLeftButtonDown="HotkeyRecordBox_MouseDown"
                                        PreviewKeyDown="HotkeyRecordBox_PreviewKeyDown"
                                        PreviewKeyUp="HotkeyRecordBox_PreviewKeyUp"
                                        LostFocus="HotkeyRecordBox_LostFocus"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="HotkeyRecordIcon" Data="{StaticResource IconBoltGeo}"
                                                  Fill="{DynamicResource AccentHoverBrush}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HotkeyDisplayPrompt"
                                                       Text="Ctrl + Shift + W"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Semibold"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right" x:Name="HotkeyRecordBadge"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="HotkeyBadgeText" Text="Click to Record"
                                                       Foreground="White" FontFamily="Segoe UI Bold" FontSize="9.5"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1" x:Name="SaveShortcutBtn"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Save"
                                        Padding="14,0"
                                        Height="36"
                                        IsEnabled="False"
                                        Click="SaveShortcutBtn_Click"
                                        ToolTip="Save and register this shortcut immediately"/>
                            </Grid>

                            <TextBlock x:Name="HotkeyHintText"
                                       Text="Status: Ready • Shortcut works globally across all games and apps."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Stealth & Panic Behavior Suite -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconPanicGeo}" Fill="{DynamicResource DangerBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="STEALTH &amp; EMERGENCY SUITE" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Automatic concealment actions executed instantly upon triggering panic."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkPanicHideApp" Content="Conceal WallSafe window on panic"
                                      Foreground="{DynamicResource TextBrush}" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkPanicMinimize" Content="Minimize all other windows (Boss-Key Win+D)"
                                      Foreground="{DynamicResource TextBrush}" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkPanicMute" Content="Mute master desktop audio"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkPanicRestore" Content="Bimodal Panic: 2nd press restores previous anime wallpaper"
                                      Foreground="{DynamicResource TextBrush}" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Automated Slideshow Engine -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconTimerGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="AUTOMATED SLIDESHOW ENGINE" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Automatically rotate desktop wallpapers on a timed interval."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkSlideshow" Content="Enable automated background rotation"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interval:" Foreground="{DynamicResource SubtextBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1" x:Name="SlideshowIntervalCombo"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Source Pool:" Foreground="{DynamicResource SubtextBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1" x:Name="SlideshowSourceCombo">
                                    <ComboBoxItem Content="Favorites Collection" Tag="favorites" IsSelected="True"/>
                                    <ComboBoxItem Content="Downloaded Wallpapers" Tag="downloads"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Display:" Foreground="{DynamicResource SubtextBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1" x:Name="MonitorTargetCombo"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Content Discretion & Blacklist -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CONTENT DISCRETION &amp; BLACKLIST" Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Segoe UI Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Client-side filtering to exclude undesired tags and shield thumbnails."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkDiscretion" Content="Discretion Mode: Blur Questionable/NSFW until hovered"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="Tag Blacklist (comma-separated):" Foreground="{DynamicResource SubtextBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <TextBox x:Name="BlacklistBox" Style="{StaticResource ModernSearchBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Image Boards & Custom Sources -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconExploreGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="IMAGE SOURCES &amp; BOORU BOARDS" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Configure Danbooru/Moebooru boards and multi-source aggregation."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkSfwOnly" Content="Strict Safe-Only Mode (konachan.net + SFW sources)"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkAllowAllSources" Content="Enable 'All Sources' multi-engine aggregation"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                            <!-- Custom Sources List Header -->
                            <TextBlock Text="Custom Danbooru / Moebooru Boards:" Foreground="{DynamicResource SubtextBrush}"
                                       FontSize="10" Margin="0,0,0,6"/>

                            <ItemsControl x:Name="CustomSourcesItemsControl" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Segoe UI Semibold"/>
                                                    <TextBlock Text="{Binding BaseUrl}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="6,2" Margin="6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SfwStatusText}" Foreground="{DynamicResource SubtextBrush}" FontSize="9"/>
                                                </Border>
                                                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="✕" Padding="6,2"
                                                        Tag="{Binding Id}" Click="RemoveCustomSource_Click" ToolTip="Remove Source"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add New Custom Source Form -->
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,6" VerticalAlignment="Center">
                                    <TextBox x:Name="NewSourceNameBox" Style="{StaticResource ModernSearchBox}"
                                             Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                             TextChanged="NewSourceNameBox_TextChanged"/>
                                    <TextBlock x:Name="NewSourceNamePlaceholder"
                                               Text="Source Name (e.g. Safebooru)"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,6" VerticalAlignment="Center">
                                    <TextBox x:Name="NewSourceUrlBox" Style="{StaticResource ModernSearchBox}"
                                             Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                             TextChanged="NewSourceUrlBox_TextChanged"/>
                                    <TextBlock x:Name="NewSourceUrlPlaceholder"
                                               Text="Base URL (e.g. safebooru.donmai.us)"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="NewSourceIsSfwChk" Content="Safe for Work (SFW)"
                                          Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TabButton}" Content="+ Add Custom Source"
                                        Height="32" Margin="4,2,0,0" VerticalAlignment="Center" Click="AddCustomSource_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Storage & Cache Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconFolderGeo}" Fill="{DynamicResource SubtextBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="STORAGE &amp; CACHE" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Local cache for fast wallpaper previews and offline storage."
                                       Foreground="{DynamicResource SubtextBrush}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CacheInfo" Text="Cache: calculating…"
                                           Foreground="{DynamicResource SubtextBrush}"
                                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource ToolButton}"
                                        Content="Clear Cache" Foreground="{DynamicResource DangerBrush}"
                                        FontSize="11" Padding="8,4"
                                        Click="ClearCache_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownloadsFolderInfo" Text="Download folder: ~/Pictures/WallSafe"
                                           Foreground="{DynamicResource SubtextBrush}"
                                           FontFamily="Segoe UI" FontSize="10" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource TabButton}"
                                        Content="Change…" Margin="8,0,0,0" Padding="8,3"
                                        Click="ChangeDownloadFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════
                 Footer Actions
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        Content="Save &amp; Apply" Padding="16,8"
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

