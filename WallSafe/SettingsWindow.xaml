<Window x:Class="WallSafe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallSafe Settings"
        FontFamily="Segoe UI"
        Width="760" Height="570"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Sidebar Section Navigation RadioButton Style -->
        <Style x:Key="SettingsNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="GroupName" Value="SettingsSectionsGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>

        <Grid x:Name="SettingsRootGrid" Margin="18" SizeChanged="SettingsRootGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Categorized 2-Column Content -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 Header Title (Draggable)
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettingsGeo}" Fill="{DynamicResource AccentHoverBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="WallSafe Settings" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI Bold" FontSize="16"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                        Click="Close_Click" Padding="8,4">
                    <Path Data="{StaticResource IconCloseGeo}" Fill="{DynamicResource SubtextBrush}"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 Main Settings Content
                 ═══════════════════════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════════════════════
                 Main 2-Column Layout: Left Sidebar + Right Content Area
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/> <!-- Left Sidebar Navigation -->
                    <ColumnDefinition Width="*"/>   <!-- Right Section Content -->
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="8,10" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe UI Bold" FontSize="9.5" Margin="8,4,0,8"/>

                        <StackPanel VerticalAlignment="Top">
                            <!-- 1. Home Dashboard -->
                            <RadioButton x:Name="NavSecHome" Style="{StaticResource SettingsNavRadioStyle}"
                                         IsChecked="True" Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconHomeGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Home Dashboard" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Panic & Stealth -->
                            <RadioButton x:Name="NavSecPanic" Style="{StaticResource SettingsNavRadioStyle}"
                                         Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconShieldGeo}" Fill="{DynamicResource EmeraldBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Panic &amp; Stealth" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Slideshow & Timers -->
                            <RadioButton x:Name="NavSecSlideshow" Style="{StaticResource SettingsNavRadioStyle}"
                                         Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTimerGeo}" Fill="{DynamicResource AmberBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Slideshow Engine" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Sources & Content -->
                            <RadioButton x:Name="NavSecSources" Style="{StaticResource SettingsNavRadioStyle}"
                                         Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconExploreGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sources &amp; Content" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. General & Storage -->
                            <RadioButton x:Name="NavSecGeneral" Style="{StaticResource SettingsNavRadioStyle}"
                                         Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSettingsGeo}" Fill="{DynamicResource SubtextBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="General &amp; Storage" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 6. Taskbar Appearance -->
                            <RadioButton x:Name="NavSecTaskbar" Style="{StaticResource SettingsNavRadioStyle}"
                                         Checked="NavSec_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconMonitorGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Taskbar Appearance" FontFamily="Segoe UI Semibold" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Right Section Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Section Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Section Content -->
                    </Grid.RowDefinitions>

                    <!-- Section Header Description -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SectionHeaderTitle" Text="HOME DASHBOARD" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11.5"/>
                                <TextBlock x:Name="SectionHeaderSubtitle" Text="Customize which sections and widgets appear on your Home page."
                                           Foreground="{DynamicResource SubtextBrush}" FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section Panels Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,0">
                            <!-- ═══════════════════════════════════════════════════════
                                 1. HOME DASHBOARD SECTION PANEL
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelHome" Visibility="Visible">
                                <!-- Quick Select/Deselect Bar -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="SELECT VISIBLE SECTIONS" Foreground="{DynamicResource SubtextBrush}"
                                               FontFamily="Segoe UI Bold" FontSize="10" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ToolButton}" Content="Show All" FontSize="10.5"
                                                Padding="6,2" Margin="0,0,4,0" Click="ShowAllHomeSections_Click"/>
                                        <Button Style="{StaticResource ToolButton}" Content="Hide All" FontSize="10.5"
                                                Padding="6,2" Click="HideAllHomeSections_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Toggle 1: Hero Spotlight Banner -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShowHomeHero" Content="Spotlight Wallpaper Banner"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Featured desktop artwork of the day with instant 1-click wallpaper apply and preview details."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A7C3AED" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Hero Banner" Foreground="{DynamicResource AccentHoverBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Toggle 2: System Status & Quick Controls Strip -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShowHomeQuickControls" Content="System Status &amp; Quick Controls Strip"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Live widget strip for panic hotkey status, slideshow playback toggle, and screen resolution."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Status Strip" Foreground="{DynamicResource EmeraldBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Toggle 3: Trending This Week -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShowHomeTrending" Content="Trending This Week Showcase"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Showcases 4 high-resolution widescreen trending desktop artworks with an 'Explore All' shortcut."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1AEF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Trending" Foreground="{DynamicResource DangerBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Toggle 4: Popular Universes & Franchises -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShowHomeFranchises" Content="Popular Universes &amp; Franchises"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Dynamic anime &amp; gaming franchise cards with live artwork counts, category filter tabs, and custom category creator."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Franchises" Foreground="{DynamicResource AccentHoverBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Toggle 5: Quick Shelf (Recent Favorites) -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShowHomeQuickShelf" Content="Your Quick Shelf (Favorites)"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Convenient quick shelf displaying your most recently bookmarked desktop wallpapers."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1AEC4899" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Quick Shelf" Foreground="{DynamicResource PinkHeartBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════════
                                 2. PANIC & STEALTH SECTION PANEL
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelPanic" Visibility="Collapsed">
                                <!-- Safe Wallpaper -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconShieldGeo}" Fill="{DynamicResource EmeraldBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="SAFE (PANIC) WALLPAPER" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="The neutral wallpaper instantly restored when triggering the panic shortcut."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <!-- Safe Preview -->
                                        <Border Height="64" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True"
                                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Image x:Name="SafeImagePreview" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBox x:Name="SafePathBox" Style="{StaticResource ModernSearchBox}"
                                                 IsReadOnly="True" Margin="0,0,0,8" TextChanged="SafePathBox_TextChanged"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource TabButton}"
                                                    Content="Browse Image…" Margin="0,0,4,0" Click="BrowseSafe_Click"/>
                                            <Button Grid.Column="1" Style="{StaticResource TabButton}"
                                                    Content="Win 11 Default" Margin="4,0,0,0" Click="ResetWin11Safe_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Global Hotkey Recorder -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconBoltGeo}" Fill="{DynamicResource AmberBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="GLOBAL PANIC HOTKEY" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Click the box below and press up to 3 keys (e.g. Ctrl + Shift + W, Alt + Q, F12) to record."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="HotkeyRecordBox"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    Cursor="Hand"
                                                    Focusable="True"
                                                    FocusVisualStyle="{x:Null}"
                                                    MouseLeftButtonDown="HotkeyRecordBox_MouseDown"
                                                    PreviewKeyDown="HotkeyRecordBox_PreviewKeyDown"
                                                    PreviewKeyUp="HotkeyRecordBox_PreviewKeyUp"
                                                    LostFocus="HotkeyRecordBox_LostFocus"
                                                    Margin="0,0,8,0">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="HotkeyRecordIcon" Data="{StaticResource IconBoltGeo}"
                                                              Fill="{DynamicResource AccentHoverBrush}"
                                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="HotkeyDisplayPrompt" Text="Ctrl + Shift + W"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontFamily="Segoe UI Semibold" FontSize="12.5" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border HorizontalAlignment="Right" x:Name="HotkeyRecordBadge"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="HotkeyBadgeText" Text="Click to Record"
                                                                   Foreground="White" FontFamily="Segoe UI Bold" FontSize="9.5"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Button Grid.Column="1" x:Name="SaveShortcutBtn"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Content="Save" Padding="14,0" Height="36" IsEnabled="False"
                                                    Click="SaveShortcutBtn_Click" ToolTip="Save and register this shortcut immediately"/>
                                        </Grid>

                                        <TextBlock x:Name="HotkeyHintText"
                                                   Text="Status: Ready • Shortcut works globally across all games and apps."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stealth & Emergency Actions -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconPanicGeo}" Fill="{DynamicResource DangerBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="STEALTH &amp; EMERGENCY BEHAVIOR" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatic concealment actions executed instantly upon triggering panic."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="ChkPanicHideApp" Content="Conceal WallSafe window on panic"
                                                  Foreground="{DynamicResource TextBrush}" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPanicMinimize" Content="Minimize all other windows (Boss-Key Win+D)"
                                                  Foreground="{DynamicResource TextBrush}" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPanicMute" Content="Mute master desktop audio"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPanicRestore" Content="Bimodal Panic: 2nd press restores previous anime wallpaper"
                                                  Foreground="{DynamicResource TextBrush}" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <!-- Wi-Fi Triggered Auto Wallpaper -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconShieldGeo}" Fill="{DynamicResource SecondaryAccentBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="WI-FI AUTO WALLPAPER" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatically switch to a safe/neutral wallpaper when you connect to a specific network (e.g. school or work Wi-Fi)."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="ChkWifiAuto" Content="Enable Wi-Fi-triggered wallpaper switching"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                                                  Checked="WifiAuto_Changed" Unchecked="WifiAuto_Changed"/>

                                        <TextBlock Text="Trigger network name (SSID):" Foreground="{DynamicResource SubtextBrush}"
                                                   FontSize="10" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="WifiSsidBox" Grid.Column="0" Style="{StaticResource ModernSearchBox}" Height="32"/>
                                            <Button Grid.Column="1" Style="{StaticResource TabButton}" Content="Use current"
                                                    Margin="8,0,0,0" Padding="10,0" Click="WifiUseCurrent_Click"
                                                    ToolTip="Fill in the network you're connected to right now"/>
                                        </Grid>

                                        <TextBlock Text="Wallpaper to apply (leave empty to use the Safe Wallpaper above):"
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="WifiWallpaperBox" Grid.Column="0" Style="{StaticResource ModernSearchBox}"
                                                     IsReadOnly="True" Height="32"/>
                                            <Button Grid.Column="1" Style="{StaticResource TabButton}" Content="Browse…"
                                                    Margin="8,0,0,0" Padding="10,0" Click="WifiBrowseWallpaper_Click"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkWifiRestore" Content="Restore previous wallpaper when leaving this network"
                                                  Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════════
                                 3. SLIDESHOW ENGINE SECTION PANEL
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelSlideshow" Visibility="Collapsed">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconTimerGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="AUTOMATED SLIDESHOW ROTATION" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatically rotate desktop wallpapers on a timed interval in the background."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,10"/>

                                        <CheckBox x:Name="ChkSlideshow" Content="Enable automated background wallpaper rotation"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Interval:" Foreground="{DynamicResource SubtextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="SlideshowIntervalCombo" Height="32"
                                                      SelectionChanged="SlideshowInterval_Changed"/>
                                            <StackPanel Grid.Column="2" x:Name="CustomIntervalPanel" Orientation="Horizontal"
                                                        Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBox x:Name="CustomIntervalBox" Width="64" Height="32"
                                                         Style="{StaticResource ModernSearchBox}"
                                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                                         ToolTip="Custom interval in minutes (1–1440)"/>
                                                <TextBlock Text="min" Foreground="{DynamicResource SubtextBrush}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Source Pool:" Foreground="{DynamicResource SubtextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="SlideshowSourceCombo" Height="32">
                                                <ComboBoxItem Content="Favorites Collection" Tag="favorites" IsSelected="True"/>
                                                <ComboBoxItem Content="Downloaded Wallpapers" Tag="downloads"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Target Display:" Foreground="{DynamicResource SubtextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="MonitorTargetCombo" Height="32"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════════
                                 4. SOURCES & BOORU BOARDS SECTION PANEL
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelSources" Visibility="Collapsed">
                                <!-- Booru Safety & Multi-Source -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="CATALOG SAFETY &amp; MULTI-ENGINE" Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="Segoe UI Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="Configure Danbooru/Moebooru safety levels and search engine aggregation."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,10"/>

                                         <TextBlock Text="DEFAULT CONTENT RATING MODE" Foreground="{DynamicResource MutedBrush}"
                                                    FontFamily="Segoe UI Bold" FontSize="9.5" Margin="0,0,0,5"/>
                                         <ComboBox x:Name="RatingModeCombo" Background="{DynamicResource CardBgBrush}"
                                                   Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                   Margin="0,0,0,10">
                                             <ComboBoxItem Content="Safe Only (SFW) — konachan.net &amp; safe sources" Tag="0"/>
                                             <ComboBoxItem Content="Questionable — Mild / Suggestive / Ecchi" Tag="1"/>
                                             <ComboBoxItem Content="Explicit (NSFW) — Unrestricted 18+ content" Tag="2"/>
                                             <ComboBoxItem x:Name="ComboItemCustom" Content="Custom — Free filter configuration &amp; saved profile" Tag="3"/>
                                         </ComboBox>

                                         <CheckBox x:Name="ChkCustomFilterProfile" Content="Enable 'Custom' Mode in Content Rating Toggle"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"
                                                   Checked="ChkCustomFilterProfile_Changed" Unchecked="ChkCustomFilterProfile_Changed"/>
                                         <TextBlock Text="When enabled, clicking the SFW toggle button cycles through all 4 modes (SFW Only ➔ Questionable ➔ Explicit ➔ Custom). When disabled, the toggle stays focused on the 3 core rating tiers."
                                                    Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="22,0,0,10"/>

                                         <CheckBox x:Name="ChkAllowAllSources" Content="Enable 'All Sources' multi-engine aggregation"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="When on, browsing defaults to querying all boards at once. You can still click a single source pill to narrow results."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Booru Boards -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOM DANBOORU / MOEBOORU BOARDS" Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="Segoe UI Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="Add external Booru endpoints to browse and download anime wallpapers."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <ItemsControl x:Name="CustomSourcesItemsControl" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Segoe UI Semibold"/>
                                                                <TextBlock Text="{Binding BaseUrl}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="6,2" Margin="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SfwStatusText}" Foreground="{DynamicResource SubtextBrush}" FontSize="9"/>
                                                            </Border>
                                                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="✕" Padding="6,2"
                                                                    Tag="{Binding Id}" Click="RemoveCustomSource_Click" ToolTip="Remove Source"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add New Custom Source Form -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,6" VerticalAlignment="Center">
                                                <TextBox x:Name="NewSourceNameBox" Style="{StaticResource ModernSearchBox}"
                                                         Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                                         TextChanged="NewSourceNameBox_TextChanged"/>
                                                <TextBlock x:Name="NewSourceNamePlaceholder"
                                                           Text="Source Name (e.g. Safebooru)"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                            <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,6" VerticalAlignment="Center">
                                                <TextBox x:Name="NewSourceUrlBox" Style="{StaticResource ModernSearchBox}"
                                                         Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                                         TextChanged="NewSourceUrlBox_TextChanged"/>
                                                <TextBlock x:Name="NewSourceUrlPlaceholder"
                                                           Text="Base URL (e.g. safebooru.donmai.us)"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="NewSourceIsSfwChk" Content="Safe for Work (SFW)"
                                                      Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TabButton}" Content="+ Add Custom Source"
                                                    Height="32" Margin="4,2,0,0" VerticalAlignment="Center" Click="AddCustomSource_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Discretion & Tag Blacklist -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="CONTENT DISCRETION &amp; BLACKLIST" Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="Segoe UI Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="Exclude undesired tags and blur sensitive preview thumbnails."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="ChkDiscretion" Content="Discretion Mode: Blur Questionable/NSFW until hovered"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                                        <TextBlock Text="Tag Blacklist (comma-separated):" Foreground="{DynamicResource SubtextBrush}"
                                                   FontSize="10" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BlacklistBox" Style="{StaticResource ModernSearchBox}" Height="32"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════════
                                 5. GENERAL & STORAGE SECTION PANEL
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelGeneral" Visibility="Collapsed">
                                <!-- Theme Mode -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconSunGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="APPEARANCE &amp; THEME" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Choose between clean Windows 11 Dark Mode or Light Mode."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDarkRadio" Content="Dark Mode"
                                                         GroupName="ThemeModeGroup" Style="{StaticResource FilterPillStyle}"
                                                         IsChecked="True" Checked="Theme_Checked" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="ThemeLightRadio" Content="Light Mode"
                                                         GroupName="ThemeModeGroup" Style="{StaticResource FilterPillStyle}"
                                                         Checked="Theme_Checked"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Interface: Grid density + Window transparency (Mica) -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconSettingsGeo}" Fill="{DynamicResource SecondaryAccentBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="INTERFACE" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Text="Wallpaper card size (grid density):"
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="DensityCompactRadio" Content="Compact"
                                                         GroupName="DensityGroup" Style="{StaticResource FilterPillStyle}"
                                                         Margin="0,0,8,0" Checked="Density_Checked"/>
                                            <RadioButton x:Name="DensityComfortableRadio" Content="Comfortable"
                                                         GroupName="DensityGroup" Style="{StaticResource FilterPillStyle}"
                                                         Margin="0,0,8,0" IsChecked="True" Checked="Density_Checked"/>
                                            <RadioButton x:Name="DensityLargeRadio" Content="Large"
                                                         GroupName="DensityGroup" Style="{StaticResource FilterPillStyle}"
                                                         Checked="Density_Checked"/>
                                        </StackPanel>

                                        <CheckBox x:Name="ChkWindowMica" Content="Window transparency (Mica) — Windows 11 only"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  Checked="WindowMica_Changed" Unchecked="WindowMica_Changed"/>
                                        <TextBlock x:Name="MicaHintText"
                                                   Text="Tints the window with your desktop wallpaper. The wallpaper grid stays opaque for clarity."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Windows Startup & Background -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconPowerGeo}" Fill="{DynamicResource AccentHoverBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="WINDOWS STARTUP &amp; BACKGROUND" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure WallSafe to launch when Windows boots and run stealthily in tray."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="ChkAutoStart" Content="Launch WallSafe on Windows startup"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"
                                                  Checked="ChkAutoStart_CheckedChanged" Unchecked="ChkAutoStart_CheckedChanged"/>

                                        <StackPanel Margin="22,0,0,0">
                                            <CheckBox x:Name="ChkStartMinimized" Content="Start hidden in background (System Tray only)"
                                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Remains minimized to system tray upon startup with reduced memory usage."
                                                       Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap" FontSize="9.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Storage & Cache -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconFolderGeo}" Fill="{DynamicResource SubtextBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="STORAGE &amp; LOCAL CACHE" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="Segoe UI Bold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="Local cache for fast wallpaper previews and high-res offline storage."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CacheInfo" Text="Cache: calculating…"
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource ToolButton}"
                                                    Content="Clear Cache" Foreground="{DynamicResource DangerBrush}"
                                                    FontSize="11" Padding="8,4" Click="ClearCache_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DownloadsFolderInfo" Text="Folder: ~/Pictures/WallSafe"
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource TabButton}"
                                                    Content="Change…" Margin="8,0,0,0" Padding="8,3"
                                                    Click="ChangeDownloadFolder_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════════
                                 6. TASKBAR APPEARANCE SECTION PANEL (merged TranslucentTB)
                                 ═══════════════════════════════════════════════════════ -->
                            <StackPanel x:Name="SecPanelTaskbar" Visibility="Collapsed">
                                <!-- Master Enable -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkTaskbarEnabled" Content="Enable Taskbar Transparency"
                                                      FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                      Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed"/>
                                            <TextBlock Text="Makes the Windows taskbar translucent, blurred or acrylic — powered by WallSafe's built-in engine."
                                                       Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Taskbar FX" Foreground="{DynamicResource AccentHoverBrush}" FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Dynamic per-state appearances (TranslucentTB-style) -->
                                <TextBlock Text="DYNAMIC MODES" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Segoe UI Bold" FontSize="11" Margin="2,0,0,3"/>
                                <TextBlock Text="Give the taskbar a different look depending on what's on screen. Higher rows win: Maximized &gt; Visible window &gt; Start opened &gt; Desktop."
                                           Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,8"/>

                                <!-- Desktop (default) -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkStateDesktop" Content="Desktop (default appearance)"
                                                  FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="StateDesktopCombo" Grid.Column="0" Height="32" SelectionChanged="TaskbarLiveApply_Changed">
                                                <ComboBoxItem Content="Normal" Tag="0"/>
                                                <ComboBoxItem Content="Opaque" Tag="1"/>
                                                <ComboBoxItem Content="Clear" Tag="2"/>
                                                <ComboBoxItem Content="Blur" Tag="3"/>
                                                <ComboBoxItem Content="Acrylic" Tag="4"/>
                                            </ComboBox>
                                            <TextBox x:Name="StateDesktopColor" Grid.Column="1" Width="108" Height="32" Margin="8,0,0,0"
                                                     Style="{StaticResource ModernSearchBox}" Text="#66000000" TextChanged="TaskbarLiveApply_Changed"/>
                                            <Border x:Name="StateDesktopSwatch" Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0"
                                                    CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#66000000"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkStateDesktopNoTint" Content="No tint (use the effect only, no color wash)"
                                                  Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,6,0,0"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Visible window -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkStateVisible" Content="Visible window (any app window open on the desktop)"
                                                  FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="StateVisibleCombo" Grid.Column="0" Height="32" SelectionChanged="TaskbarLiveApply_Changed">
                                                <ComboBoxItem Content="Normal" Tag="0"/>
                                                <ComboBoxItem Content="Opaque" Tag="1"/>
                                                <ComboBoxItem Content="Clear" Tag="2"/>
                                                <ComboBoxItem Content="Blur" Tag="3"/>
                                                <ComboBoxItem Content="Acrylic" Tag="4"/>
                                            </ComboBox>
                                            <TextBox x:Name="StateVisibleColor" Grid.Column="1" Width="108" Height="32" Margin="8,0,0,0"
                                                     Style="{StaticResource ModernSearchBox}" Text="#99000000" TextChanged="TaskbarLiveApply_Changed"/>
                                            <Border x:Name="StateVisibleSwatch" Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0"
                                                    CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#99000000"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkStateVisibleNoTint" Content="No tint (use the effect only, no color wash)"
                                                  Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,6,0,0"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Maximized window -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkStateMaximized" Content="Maximized window (a window is maximized)"
                                                  FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="StateMaximizedCombo" Grid.Column="0" Height="32" SelectionChanged="TaskbarLiveApply_Changed">
                                                <ComboBoxItem Content="Normal" Tag="0"/>
                                                <ComboBoxItem Content="Opaque" Tag="1"/>
                                                <ComboBoxItem Content="Clear" Tag="2"/>
                                                <ComboBoxItem Content="Blur" Tag="3"/>
                                                <ComboBoxItem Content="Acrylic" Tag="4"/>
                                            </ComboBox>
                                            <TextBox x:Name="StateMaximizedColor" Grid.Column="1" Width="108" Height="32" Margin="8,0,0,0"
                                                     Style="{StaticResource ModernSearchBox}" Text="#FF1C1C1C" TextChanged="TaskbarLiveApply_Changed"/>
                                            <Border x:Name="StateMaximizedSwatch" Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0"
                                                    CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#FF1C1C1C"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkStateMaximizedNoTint" Content="No tint (use the effect only, no color wash)"
                                                  Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,6,0,0"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Start opened -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkStateStart" Content="Start opened (Start menu is open)"
                                                  FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="StateStartCombo" Grid.Column="0" Height="32" SelectionChanged="TaskbarLiveApply_Changed">
                                                <ComboBoxItem Content="Normal" Tag="0"/>
                                                <ComboBoxItem Content="Opaque" Tag="1"/>
                                                <ComboBoxItem Content="Clear" Tag="2"/>
                                                <ComboBoxItem Content="Blur" Tag="3"/>
                                                <ComboBoxItem Content="Acrylic" Tag="4"/>
                                            </ComboBox>
                                            <TextBox x:Name="StateStartColor" Grid.Column="1" Width="108" Height="32" Margin="8,0,0,0"
                                                     Style="{StaticResource ModernSearchBox}" Text="#66000000" TextChanged="TaskbarLiveApply_Changed"/>
                                            <Border x:Name="StateStartSwatch" Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0"
                                                    CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#66000000"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkStateStartNoTint" Content="No tint (use the effect only, no color wash)"
                                                  Foreground="{DynamicResource SubtextBrush}" FontSize="10" Margin="0,6,0,0"
                                                  Checked="TaskbarLiveApply_Changed" Unchecked="TaskbarLiveApply_Changed"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Color format is #AARRGGBB hex — the AA (alpha) controls tint strength (e.g. #66000000 ≈ 40% black)."
                                           Foreground="{DynamicResource SubtextBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="2,0,0,10"/>

                                <!-- Panic Integration -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkTaskbarRestoreOnPanic" Content="Revert taskbar to Normal during Panic"
                                                  FontFamily="Segoe UI Semibold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="When you trigger the panic hotkey, the taskbar returns to its default look for a clean screen; the second (restore) press brings your custom appearance back."
                                                   Foreground="{DynamicResource SubtextBrush}" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 Footer Actions
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Text="Changes are saved and applied automatically."
                           Foreground="{DynamicResource SubtextBrush}" FontSize="10.5" FontFamily="Segoe UI"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        Content="Done" Padding="18,7"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

