<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>WallSafe.ico</ApplicationIcon>
    <AssemblyName>WallSafe</AssemblyName>
    <RootNamespace>WallSafe</RootNamespace>
    <AssemblyTitle>WallSafe</AssemblyTitle>
    <Description>Modern anime desktop wallpaper manager with instant panic hotkey protection.</Description>
    <Version>2.2.1</Version>
    <Authors>WallSafe Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="WallSafe.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
