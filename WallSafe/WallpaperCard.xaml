<UserControl x:Class="WallSafe.WallpaperCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260" d:DesignHeight="150"
             Margin="4">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardActionBtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CardActionBtnFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardActionBtnBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavBtnStyle" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="#F43F5E"/>
                    <Setter Property="Background" Value="#33F43F5E"/>
                    <Setter Property="BorderBrush" Value="#F43F5E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Set as Desktop Wallpaper" Click="ContextMenu_SetWallpaper"/>
            <MenuItem Header="Set as Windows Lock Screen" Click="ContextMenu_SetLockScreen"/>
            <Separator/>
            <MenuItem Header="Toggle Favorite" Click="ContextMenu_ToggleFavorite"/>
            <MenuItem Header="Move to Collection…" Click="ContextMenu_MoveToCollection"/>
            <MenuItem Header="Download Original (Full-Res)" Click="ContextMenu_Download"/>
            <Separator/>
            <MenuItem Header="Copy Image URL" Click="ContextMenu_CopyUrl"/>
            <MenuItem Header="Open in Browser" Click="ContextMenu_OpenWeb"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border x:Name="CardBorder" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Focusable="True" KeyboardNavigation.IsTabStop="True" Cursor="Hand"
            AutomationProperties.Name="Wallpaper. Press Enter to preview, A to apply, F to favorite, D to download."
            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            MouseMove="Card_MouseMove"
            KeyDown="Card_KeyDown"
            GotKeyboardFocus="Card_GotKeyboardFocus"
            LostKeyboardFocus="Card_LostKeyboardFocus">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <Grid x:Name="CardRootGrid" SizeChanged="CardRootGrid_SizeChanged">
            <!-- Background Image with Discretion Blur Support -->
            <Image x:Name="ThumbImage"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDiscreet}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="24" KernelType="Gaussian"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Loading Placeholder (shown while image loads) -->
            <Border x:Name="LoadingPlaceholder" Background="{DynamicResource CardBgBrush}" Visibility="Visible">
                <Path Data="{StaticResource IconRefreshGeo}" Fill="{DynamicResource MutedBrush}"
                      Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0.4" IsHitTestVisible="False"/>
            </Border>

            <!-- Error Placeholder (shown when image URL fails to load) -->
            <Border x:Name="ErrorPlaceholder" Background="{DynamicResource CardBgBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconExploreGeo}" Fill="{DynamicResource MutedBrush}"
                          Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="No preview" Foreground="{DynamicResource MutedBrush}" FontSize="9"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Top Badges (Subtle, sleek pills) -->
            <Grid VerticalAlignment="Top" Margin="6,6,6,0">
                <!-- Rating Pill (SFW / NSFW) -->
                <Border HorizontalAlignment="Left" CornerRadius="3" Padding="5,1"
                        Background="{Binding RatingBadgeBackground}">
                    <TextBlock Text="{Binding RatingDisplay}" FontSize="8.5"
                               FontFamily="Segoe UI Semibold" Foreground="White"/>
                </Border>

                <!-- Resolution / Aspect ratio -->
                <Border HorizontalAlignment="Right" Background="#99000000"
                        CornerRadius="3" Padding="5,1">
                    <TextBlock Text="{Binding AspectRatioText}" FontSize="8.5"
                               FontFamily="Segoe UI" Foreground="#E2E8F0"/>
                </Border>
            </Grid>

            <!-- Download Progress Overlay -->
            <ProgressBar x:Name="DownloadBar" Height="3" VerticalAlignment="Bottom"
                         Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed" Foreground="{DynamicResource EmeraldBrush}"
                         Background="Transparent" BorderThickness="0"/>

            <!-- Always visible bottom info bar with metadata and 3 quick-action buttons (icon only) -->
            <Border VerticalAlignment="Bottom" Background="{DynamicResource CardBottomBarBrush}" Padding="6,2" Height="28">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Resolution & Score -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResolutionText}" Foreground="{DynamicResource SubtextBrush}"
                                   FontSize="9" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Score, StringFormat='  ★ {0}'}" Foreground="#F59E0B"
                                   FontSize="8.5" FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Icon-Only Action Buttons (Favorite, Apply, Download) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Favorite Toggle (♥) -->
                        <Button x:Name="CardFavBtn" Style="{StaticResource CardActionBtn}" ToolTip="Favorite (F)"
                                AutomationProperties.Name="Toggle favorite"
                                Click="Favorite_Click" Margin="0,0,4,0" Width="22" Height="22">
                            <Path x:Name="CardFavIcon" Data="{StaticResource IconHeartGeo}"
                                  Fill="{DynamicResource CardActionBtnFgBrush}" Stretch="Uniform" Width="10.5" Height="10.5"/>
                        </Button>

                        <!-- 2. Set Wallpaper (⚡) -->
                        <Button x:Name="CardApplyBtn" Style="{StaticResource CardActionBtn}" ToolTip="Apply as Desktop Wallpaper (A)"
                                AutomationProperties.Name="Apply as desktop wallpaper"
                                Click="SetWallpaper_Click" Margin="0,0,4,0" Width="22" Height="22">
                            <Path x:Name="CardApplyIcon" Data="{StaticResource IconBoltGeo}" Fill="#8B5CF6"
                                  Stretch="Uniform" Width="10" Height="10"/>
                        </Button>

                        <!-- 3. Download Full-Res (📥) -->
                        <Button x:Name="CardDownloadBtn" Style="{StaticResource CardActionBtn}" ToolTip="Download Original Wallpaper (D)"
                                AutomationProperties.Name="Download original full resolution wallpaper"
                                Click="Download_Click" Margin="0,0,3,0" Width="22" Height="22">
                            <Path x:Name="DownloadIconPath" Data="{StaticResource IconDownloadGeo}" Fill="#0EA5E9"
                                  Stretch="Uniform" Width="10" Height="10"/>
                        </Button>

                        <!-- 4. Open in Web Browser (↗) -->
                        <Button Style="{StaticResource CardActionBtn}" ToolTip="View on Web Source"
                                AutomationProperties.Name="Open source post in web browser"
                                Click="OpenWeb_Click" Width="22" Height="22">
                            <Path Data="{StaticResource IconExternalGeo}" Fill="{DynamicResource MutedBrush}" Stretch="Uniform" Width="9.5" Height="9.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Success / Error Notification Overlay (clickable to retry on errors) -->
            <Border x:Name="NoticeOverlay" Background="{DynamicResource AccentBrush}" CornerRadius="6"
                    Margin="10" VerticalAlignment="Center" Visibility="Collapsed"
                    Padding="12,8" MouseLeftButtonDown="NoticeOverlay_Click">
                <TextBlock x:Name="NoticeText" Text="Wallpaper Set!" Foreground="White"
                           FontFamily="Segoe UI Semibold" FontSize="11" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>

            <!-- Keyboard Focus Ring (shown only when the card has keyboard focus) -->
            <Border x:Name="FocusRing" CornerRadius="8" IsHitTestVisible="False"
                    Visibility="Collapsed" BorderThickness="2.5"
                    BorderBrush="{DynamicResource AccentHoverBrush}"/>
        </Grid>
    </Border>
</UserControl>
