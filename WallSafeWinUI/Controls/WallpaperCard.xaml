<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WallSafeWinUI.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WallSafeWinUI.Controls"
    xmlns:controls="using:WallSafeWinUI.Controls">

    <!-- Border gives us a real clip so the image corners are actually rounded. -->
    <Border x:Name="RootCard" CornerRadius="12" DoubleTapped="RootCard_DoubleTapped"
            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource WallSafeAcrylicCardBrush}"
            PointerEntered="RootCard_PointerEntered" PointerExited="RootCard_PointerExited">
        <Border.Resources>
            <Style TargetType="Button" x:Key="CardActionButtonStyle">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#73000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#2BFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Border.Resources>

        <Grid>
            <!-- Normal sharp thumbnail (revealed on hover or when discretion is off) -->
            <Image x:Name="Thumb" Stretch="UniformToFill" controls:CachedImage.DecodeWidth="640" />

            <!-- Genuine photographic Gaussian StackBlurred image layer (active when discretion mode is on) -->
            <Image x:Name="BlurredThumb" Stretch="UniformToFill" controls:CachedImage.IsBlurred="True" Opacity="0" />

            <!-- Soft frosted veil over blur for smooth, aesthetic look -->
            <Border x:Name="BlurVeil" Background="#15000000" Opacity="0" IsHitTestVisible="False" />

            <!-- Rating badge -->
            <Border x:Name="RatingBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8" CornerRadius="6" Padding="7,2">
                <TextBlock x:Name="RatingText" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
            </Border>

            <!-- Bottom gradient + info + actions -->
            <Grid VerticalAlignment="Bottom">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.55" Color="#80000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Padding="10,22,10,10" Spacing="6">
                    <TextBlock x:Name="ResText" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF" />
                    <StackPanel x:Name="ActionBar" Orientation="Horizontal" Spacing="6" Opacity="0.85">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="View full image" Click="View_Click">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        </Button>
                        <Button x:Name="FavBtn" Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Favorite" Click="Fav_Click">
                            <FontIcon x:Name="FavIcon" Glyph="&#xEB51;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Apply wallpaper" Click="Apply_Click">
                            <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                        </Button>
                        <Button x:Name="DownloadBtn" Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Download" Click="Download_Click">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Open source in browser" Click="Source_Click">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Download progress -->
            <ProgressBar x:Name="DlProgress" VerticalAlignment="Top" Visibility="Collapsed"
                         IsIndeterminate="False" Minimum="0" Maximum="1" />
        </Grid>
    </Border>
</UserControl>
