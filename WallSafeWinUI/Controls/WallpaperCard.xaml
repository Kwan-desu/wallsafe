<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WallSafeWinUI.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WallSafeWinUI.Controls"
    xmlns:controls="using:WallSafeWinUI.Controls">

    <!-- Border gives us a real clip so the image corners are actually rounded. -->
    <Border x:Name="RootCard" CornerRadius="12" DoubleTapped="RootCard_DoubleTapped"
            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource WallSafeAcrylicCardBrush}"
            PointerEntered="RootCard_PointerEntered" PointerExited="RootCard_PointerExited">
        <Border.Resources>
            <Style TargetType="Button" x:Key="CardActionButtonStyle">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="#66000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Border.Resources>

        <Grid>
            <!-- Thumbnail (fills the card, clipped by the Border's CornerRadius) -->
            <Image x:Name="Thumb" Stretch="UniformToFill" controls:CachedImage.DecodeWidth="640" />

            <!-- Discretion privacy blur overlay -->
            <Border x:Name="BlurOverlay" Background="#F218181B" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED1A;" FontSize="20" Foreground="#F0FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sensitive Content" FontSize="12" FontWeight="SemiBold"
                               Foreground="#E0FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Hover to reveal" FontSize="10"
                               Foreground="#90FFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Rating badge -->
            <Border x:Name="RatingBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10" CornerRadius="7" Padding="8,3">
                <TextBlock x:Name="RatingText" FontSize="11" FontWeight="SemiBold" Foreground="White" />
            </Border>

            <!-- Bottom gradient + info + actions -->
            <Grid VerticalAlignment="Bottom">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.55" Color="#80000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Padding="12,26,12,12" Spacing="8">
                    <TextBlock x:Name="ResText" FontSize="12" FontWeight="SemiBold" Foreground="#F0FFFFFF" />
                    <StackPanel x:Name="ActionBar" Orientation="Horizontal" Spacing="8" Opacity="0.85">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="View full image" Click="View_Click">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                        </Button>
                        <Button x:Name="FavBtn" Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Favorite" Click="Fav_Click">
                            <FontIcon x:Name="FavIcon" Glyph="&#xEB51;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Apply wallpaper" Click="Apply_Click">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                        </Button>
                        <Button x:Name="DownloadBtn" Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Download" Click="Download_Click">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTipService.ToolTip="Open source in browser" Click="Source_Click">
                            <FontIcon Glyph="&#xE774;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Download progress -->
            <ProgressBar x:Name="DlProgress" VerticalAlignment="Top" Visibility="Collapsed"
                         IsIndeterminate="False" Minimum="0" Maximum="1" />
        </Grid>
    </Border>
</UserControl>
