<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WallSafeWinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WallSafeWinUI.Controls"
    xmlns:services="using:WallSafeWinUI.Services"
    Background="Transparent">

    <Page.Resources>
        <!-- Frameless subtle nav arrow for horizontal shelf carousels (Windows App style) -->
        <Style x:Key="ShelfNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="36,24,36,40" Spacing="6" MaxWidth="1600">

            <!-- Page title -->
            <TextBlock x:Name="GreetingText" Text="Home" FontSize="28" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="GreetingSub" Text="Your wallpaper dashboard"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" FontSize="13" />

            <!-- Overview stats row (aligned with horizontal carousels) -->
            <Grid x:Name="StatsRow" ColumnSpacing="14" Margin="0,4,0,16" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Favorites -->
                <Border Grid.Column="0" Style="{StaticResource WallSafeCardStyle}" Padding="18,16" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB52;" FontSize="18" Foreground="{ThemeResource WallSafeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatFav" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Favorites" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Downloads -->
                <Border Grid.Column="1" Style="{StaticResource WallSafeCardStyle}" Padding="18,16" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource WallSafeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatDl" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Downloads" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Applied -->
                <Border Grid.Column="2" Style="{StaticResource WallSafeCardStyle}" Padding="18,16" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource WallSafeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatApplied" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Applied" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Top pick -->
                <Border Grid.Column="3" Style="{StaticResource WallSafeCardStyle}" Padding="18,16" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{ThemeResource WallSafeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatTopTag" Text="—" FontSize="16" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Top pick" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Panic triggers count -->
                <Border Grid.Column="4" Style="{StaticResource WallSafeCardStyle}" Padding="18,16" CornerRadius="12"
                        ToolTipService.ToolTip="Number of times emergency safe wallpaper was triggered">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource WallSafeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatPanic" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Panics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Trending shelf ================= -->
            <Grid x:Name="TrendingHeaderRow" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TrendingHeader" Text="Trending this week" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="See all ›" Click="ViewAllTrending_Click"
                                 FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer x:Name="TrendingScroller"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          PointerWheelChanged="ShelfScroller_PointerWheelChanged">
                <ItemsControl x:Name="TrendingList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PostItem">
                            <controls:WallpaperCard Width="300" Height="185" PreviewHook="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ProgressRing x:Name="TrendingLoader" Width="24" Height="24" IsActive="False" HorizontalAlignment="Center" Margin="0,6,0,0" />

            <!-- Carousel navigation row -->
            <Grid Margin="0,6,0,12">
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Left"
                        Click="TrendingLeft_Click" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                </Button>
                <PipsPager x:Name="TrendingPager" HorizontalAlignment="Center"
                           PreviousButtonVisibility="Collapsed" NextButtonVisibility="Collapsed"
                           SelectedIndexChanged="TrendingPager_SelectedIndexChanged" />
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Right"
                        Click="TrendingRight_Click" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                </Button>
            </Grid>

            <!-- ================= Franchises shelf ================= -->
            <Grid x:Name="FranchiseHeaderRow" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Popular universes &amp; franchises" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FranchiseSubtitle" Text="Live ranking" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="See all ›" VerticalAlignment="Center" Click="Explore_Click"
                                 FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ScrollViewer x:Name="FranchiseScroller"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          PointerWheelChanged="ShelfScroller_PointerWheelChanged">
                <ItemsControl x:Name="FranchiseList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:SeriesCategoryItem">
                            <Border Width="280" Height="160" CornerRadius="12" Tapped="Franchise_Tapped" Tag="{x:Bind Tag}"
                                    Background="{ThemeResource WallSafeAcrylicCardBrush}"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Image Stretch="UniformToFill" Opacity="0.7"
                                           controls:CachedImage.SourceUrl="{x:Bind PreviewImageUrl, Mode=OneWay}"
                                           controls:CachedImage.DecodeWidth="420" />
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#22000000" />
                                                <GradientStop Offset="1" Color="#DD000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Padding="14" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="5" Padding="6,2" Background="#55FFFFFF">
                                                <TextBlock Text="{x:Bind Type}" FontSize="10" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{x:Bind PostCountDisplay, Mode=OneWay}" FontSize="12"
                                                       Foreground="#DDFFFFFF" VerticalAlignment="Center" />
                                            <TextBlock Text="Artworks" FontSize="12" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ProgressRing x:Name="FranchiseLoader" Width="24" Height="24" IsActive="False" HorizontalAlignment="Center" Margin="0,6,0,0" />

            <!-- Carousel navigation row -->
            <Grid Margin="0,6,0,12">
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Left"
                        Click="FranchiseLeft_Click" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                </Button>
                <PipsPager x:Name="FranchisePager" HorizontalAlignment="Center"
                           PreviousButtonVisibility="Collapsed" NextButtonVisibility="Collapsed"
                           SelectedIndexChanged="FranchisePager_SelectedIndexChanged" />
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Right"
                        Click="FranchiseRight_Click" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                </Button>
            </Grid>

            <!-- ================= Favorites shelf ================= -->
            <Grid x:Name="ShelfHeaderRow" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShelfHeader" Text="Your favorites" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="See all ›" Click="ViewAllFavorites_Click"
                                 FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer x:Name="ShelfScroller"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          PointerWheelChanged="ShelfScroller_PointerWheelChanged">
                <ItemsControl x:Name="ShelfList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PostItem">
                            <controls:WallpaperCard Width="280" Height="175" PreviewHook="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="ShelfEmpty" Text="No favorites yet — tap the heart on any wallpaper to build your shelf."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="4,6,0,6" />

            <!-- Carousel navigation row -->
            <Grid x:Name="ShelfNavRow" Margin="0,6,0,12">
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Left"
                        Click="ShelfLeft_Click" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                </Button>
                <PipsPager x:Name="ShelfPager" HorizontalAlignment="Center"
                           PreviousButtonVisibility="Collapsed" NextButtonVisibility="Collapsed"
                           SelectedIndexChanged="ShelfPager_SelectedIndexChanged" />
                <Button Style="{StaticResource ShelfNavButtonStyle}" HorizontalAlignment="Right"
                        Click="ShelfRight_Click" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
