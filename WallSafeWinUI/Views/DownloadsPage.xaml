<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WallSafeWinUI.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WallSafeWinUI.Controls"
    xmlns:services="using:WallSafeWinUI.Services"
    Background="Transparent">

    <Grid Margin="24,12,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Downloads" Style="{StaticResource TitleTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <Button Grid.Row="1" Content="Open downloads folder" Click="OpenFolder_Click" HorizontalAlignment="Left" />

        <Grid Grid.Row="2">
            <GridView x:Name="Grid" SelectionMode="None" Padding="0,0,0,24"
                      SizeChanged="Grid_SizeChanged"
                      ItemContainerStyle="{StaticResource WallSafeGridViewItemStyle}"
                      ContainerContentChanging="Grid_ContainerContentChanging">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="services:PostItem">
                        <controls:WallpaperCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="6" />
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No downloads yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
