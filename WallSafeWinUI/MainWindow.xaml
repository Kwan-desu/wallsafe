<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WallSafeWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native WinUI 3 Title Bar (seamless background, 44px standard height) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Identity (Left) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="16,0,12,0" VerticalAlignment="Center">
                <Image Source="Assets/WallSafe.ico" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="WallSafe"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Middle Draggable Region -->
            <Grid x:Name="TitleBarDragArea" Grid.Column="1" Background="Transparent" />

            <!-- TitleBar Action Controls (Right) -->
            <StackPanel x:Name="TitleBarControls" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0">
                <!-- Quick Slideshow Flyout Button (Fluent pill) -->
                <Button x:Name="SlideshowBtn" Style="{StaticResource WallSafePillButtonStyle}"
                        ToolTipService.ToolTip="Wallpaper Slideshow auto-rotation settings and toggle">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon x:Name="SlideshowIcon" Glyph="&#xE768;" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="SlideshowLabel" Text="Slideshow: Off" FontSize="11.5" VerticalAlignment="Center" />
                        <FontIcon x:Name="SlideshowChevron" Glyph="&#xE70D;" FontSize="7" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="270" Spacing="12">
                                <TextBlock Text="Wallpaper Slideshow" FontWeight="SemiBold" FontSize="15" />
                                <ToggleSwitch x:Name="FlyoutSlideshowSwitch" Header="Auto-rotate wallpapers" Toggled="FlyoutSlideshow_Toggled" />
                                <ComboBox x:Name="FlyoutSourceCombo" Header="Source" HorizontalAlignment="Stretch" SelectionChanged="FlyoutSource_Changed">
                                    <ComboBoxItem Content="Favorites collection" Tag="favorites" />
                                    <ComboBoxItem Content="Downloads folder" Tag="downloads" />
                                </ComboBox>
                                <ComboBox x:Name="FlyoutIntervalCombo" Header="Rotation interval" HorizontalAlignment="Stretch" SelectionChanged="FlyoutInterval_Changed">
                                    <ComboBoxItem Content="30 seconds" Tag="30s" />
                                    <ComboBoxItem Content="1 minute" Tag="1m" />
                                    <ComboBoxItem Content="5 minutes" Tag="5m" />
                                    <ComboBoxItem Content="15 minutes" Tag="15m" />
                                    <ComboBoxItem Content="30 minutes" Tag="30m" />
                                    <ComboBoxItem Content="1 hour" Tag="1h" />
                                </ComboBox>
                                <Button HorizontalAlignment="Stretch" Click="FlyoutNext_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                                        <TextBlock Text="Next wallpaper now" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Quick Discretion Blur Button (Fluent pill) -->
                <Button x:Name="TitleDiscretionBtn" Style="{StaticResource WallSafePillButtonStyle}"
                        Click="TitleDiscretionBtn_Click"
                        ToolTipService.ToolTip="Discretion blur: Blur sensitive thumbnails">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon x:Name="TitleDiscretionIcon" Glyph="&#xED1A;" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleDiscretionLabel" Text="Blur: Off" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 3-mode rating selector (SFW / Questionable / Explicit) (Fluent segmented pill) -->
                <Border Height="30" CornerRadius="6" Padding="2"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton x:Name="ModeSfw" GroupName="RatingMode"
                                     Style="{StaticResource WallSafeSegmentStyle}"
                                     Checked="RatingMode_Checked" Tag="SfwOnly">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                                <TextBlock Text="SFW" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeQuestionable" GroupName="RatingMode"
                                     Style="{StaticResource WallSafeSegmentStyle}"
                                     Checked="RatingMode_Checked" Tag="Questionable">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                                <TextBlock Text="Questionable" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeExplicit" GroupName="RatingMode"
                                     Style="{StaticResource WallSafeSegmentStyle}"
                                     Checked="RatingMode_Checked" Tag="Explicit">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center" />
                                <TextBlock Text="Explicit" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Caption Buttons Spacer (Min/Max/Close reservation, dynamically sized in code) -->
            <Border x:Name="CaptionPaddingArea" Grid.Column="3" Width="140" Background="Transparent" />
        </Grid>

        <!-- Navigation + content -->
        <NavigationView x:Name="RootNav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Background="Transparent"
                        OpenPaneLength="248"
                        SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explore" Tag="Explore">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB52;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
