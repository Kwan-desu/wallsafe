<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WallSafeWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom acrylic title bar -->
        <Border Grid.Row="0" Background="{ThemeResource WallSafeBarAcrylicBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="AppTitleBar" Height="44" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" Margin="16,0,0,0"
                          VerticalAlignment="Center" Foreground="{ThemeResource WallSafeAccentBrush}" />

                <TextBlock Grid.Column="1" Text="WallSafe"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- TitleBar Action Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,152,0" VerticalAlignment="Center">
                    <!-- Quick Slideshow Flyout Button -->
                    <Button x:Name="SlideshowBtn" Padding="8,5" CornerRadius="8"
                            Background="{ThemeResource WallSafeAcrylicCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Wallpaper Slideshow auto-rotation settings and toggle">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="SlideshowIcon" Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource WallSafeAccentBrush}" />
                            <TextBlock x:Name="SlideshowLabel" Text="Slideshow: Off" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="270" Spacing="12">
                                    <TextBlock Text="Wallpaper Slideshow" FontWeight="SemiBold" FontSize="15" />
                                    <ToggleSwitch x:Name="FlyoutSlideshowSwitch" Header="Auto-rotate wallpapers" Toggled="FlyoutSlideshow_Toggled" />
                                    <ComboBox x:Name="FlyoutSourceCombo" Header="Source" HorizontalAlignment="Stretch" SelectionChanged="FlyoutSource_Changed">
                                        <ComboBoxItem Content="Favorites collection" Tag="favorites" />
                                        <ComboBoxItem Content="Downloads folder" Tag="downloads" />
                                    </ComboBox>
                                    <ComboBox x:Name="FlyoutIntervalCombo" Header="Rotation interval" HorizontalAlignment="Stretch" SelectionChanged="FlyoutInterval_Changed">
                                        <ComboBoxItem Content="30 seconds" Tag="30s" />
                                        <ComboBoxItem Content="1 minute" Tag="1m" />
                                        <ComboBoxItem Content="5 minutes" Tag="5m" />
                                        <ComboBoxItem Content="15 minutes" Tag="15m" />
                                        <ComboBoxItem Content="30 minutes" Tag="30m" />
                                        <ComboBoxItem Content="1 hour" Tag="1h" />
                                    </ComboBox>
                                    <Button HorizontalAlignment="Stretch" Click="FlyoutNext_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                                            <TextBlock Text="Next wallpaper now" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- 3-mode rating selector (SFW / Questionable / Explicit) -->
                    <Border CornerRadius="8" Padding="3"
                            Background="{ThemeResource WallSafeAcrylicCardBrush}"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="ModeSfw" GroupName="RatingMode" Content="SFW"
                                         Style="{StaticResource WallSafeSegmentStyle}"
                                         Checked="RatingMode_Checked" Tag="SfwOnly" />
                            <RadioButton x:Name="ModeQuestionable" GroupName="RatingMode" Content="Questionable"
                                         Style="{StaticResource WallSafeSegmentStyle}"
                                         Checked="RatingMode_Checked" Tag="Questionable" />
                            <RadioButton x:Name="ModeExplicit" GroupName="RatingMode" Content="Explicit"
                                         Style="{StaticResource WallSafeSegmentStyle}"
                                         Checked="RatingMode_Checked" Tag="Explicit" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation + content -->
        <NavigationView x:Name="RootNav" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Background="Transparent"
                        OpenPaneLength="248"
                        SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explore" Tag="Explore">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB52;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
